# kanshi: monitor configuration for river/rivermonad.
# Changes apply when kanshi starts (it is launched from ~/.config/river/init).
# Reload after editing:  pkill -x kanshi; setsid -f kanshi
#
# "output NAME" options:
#   mode WxH[@Hz]      resolution, e.g. mode 1920x1080@60
#   scale N            zoom: 1, 1.25, 1.5, 2 ... (fractional is fine)
#   position X,Y       placement when there are several monitors
#   enable / disable
#
# Each "profile" applies when exactly its monitors are connected.

profile vm {
    # A fixed "mode" (4K at 60 Hz). If the VM window changes size and the
    # mode no longer exists, kanshi rejects the whole profile: remove
    # "mode ..." to use the preferred (native) resolution instead.
    # Zoom: 2 is like macOS on Retina; higher = bigger, lower = more room.
    output Virtual-1 mode 3840x2160@60 scale 2
}

# Real hardware (not this VM: virtio-gpu rejects adaptive_sync, and kanshi
# drops a whole profile when one setting fails, zoom included).
# Uncomment and set the connector name, shown by `wlr-randr` (DP-1,
# HDMI-A-1, eDP-1...). adaptive_sync = VRR/FreeSync/G-Sync Compatible: the
# refresh rate follows the frames the game or video produces; together with
# rivermonad's tearing support it gives the lowest latency in games.
