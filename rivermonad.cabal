cabal-version:      3.0
name:               rivermonad
version:            0.1.0
synopsis:           An xmonad-style tiling window manager for the river Wayland compositor
description:
  rivermonad brings xmonad's model (StackSet, layouts, manage hooks and a
  Haskell configuration file) to Wayland. It runs as the window manager
  process of river >= 0.4 and talks to it through the
  river-window-management-v1 protocol, implemented in pure Haskell.
license:            BSD-3-Clause
license-file:       LICENSE
author:             prietus
maintainer:         prietus@live.com
category:           System
build-type:         Simple
extra-doc-files:    README.md
data-files:         examples/rivermonad.hs
extra-source-files: protocol/*.xml, tools/gen-protocol.py, tools/regen.sh, cbits/*.c,
                    contrib/session/README.md, contrib/session/init, contrib/session/install.sh,
                    contrib/session/river-session, contrib/session/rivermonad.desktop

flag dynamic-config
  description: Link the user configuration dynamically (-dynamic), for
               distributions that ship Haskell libraries as shared objects
               only, like Arch Linux.
  default:     False
  manual:      True

common warnings
  ghc-options: -Wall -Wno-name-shadowing -Wno-orphans

library
  import:           warnings
  if flag(dynamic-config)
    cpp-options:    -DDYNAMIC_CONFIG
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions: LambdaCase
  exposed-modules:
    Rivermonad
    Rivermonad.Actions.CycleWS
    Rivermonad.Config
    Rivermonad.Core
    Rivermonad.Engine
    Rivermonad.Hooks.InsertPosition
    Rivermonad.Hooks.ManageHelpers
    Rivermonad.Hooks.StatusBar
    Rivermonad.IPC
    Rivermonad.Input
    Rivermonad.Keysym
    Rivermonad.Layout
    Rivermonad.Layout.Grid
    Rivermonad.Layout.LayoutModifier
    Rivermonad.Layout.NoBorders
    Rivermonad.Layout.PerWorkspace
    Rivermonad.Layout.ResizableTile
    Rivermonad.Layout.Spacing
    Rivermonad.Layout.ThreeColumns
    Rivermonad.Layout.ToggleLayouts
    Rivermonad.JSON
    Rivermonad.Main
    Rivermonad.ManageHook
    Rivermonad.Operations
    Rivermonad.Recompile
    Rivermonad.Shadows
    Rivermonad.StackSet
    Rivermonad.Status
    Rivermonad.Util.EZConfig
    Rivermonad.Util.ExtensibleState
    Rivermonad.Util.NamedScratchpad
    Rivermonad.Util.SpawnOnce
    Rivermonad.Wayland.Protocol
    Rivermonad.Wayland.Wire
  other-modules:    Paths_rivermonad
  c-sources:        cbits/rivermonad.c
  pkgconfig-depends: xkbcommon
  extra-libraries:  m
  autogen-modules:  Paths_rivermonad
  build-depends:
      base        >=4.16 && <5
    , binary      >=0.8  && <0.11
    , bytestring  >=0.11 && <0.13
    , containers  >=0.6  && <0.8
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6
    , mtl         >=2.2  && <2.4
    , network     >=3.1  && <3.3
    , process     >=1.6  && <1.7
    , text        >=2.0  && <2.2
    , unix        >=2.7  && <2.9

executable rivermonad
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -threaded -rtsopts
  build-depends:    base, rivermonad

test-suite stackset
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          StackSetTests.hs
  hs-source-dirs:   tests
  default-language: GHC2021
  build-depends:    base, containers, rivermonad
